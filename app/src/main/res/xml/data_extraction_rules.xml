<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup: the player's progress follows them to a new phone or a
   reinstall. Only game data is included; WebView and ad SDK caches are not.
   Keep in sync with backup_rules.xml (Android 11 and older).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
        <include domain="file" path="player_stats.json" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="achievements_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves/" />
        <include domain="file" path="player_stats.json" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="achievements_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
