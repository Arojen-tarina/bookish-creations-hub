<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ArojenTarinat" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ink_900</item>
        <item name="android:colorAccent">@color/gold</item>
    </style>

    <!-- System splash (Android 12+ API, back-ported by core-splashscreen) -->
    <style name="Theme.ArojenTarinat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/emblem_compass</item>
        <item name="postSplashScreenTheme">@style/Theme.ArojenTarinat</item>
    </style>
</resources>
