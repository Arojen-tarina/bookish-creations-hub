    <!-- Moose guide -->
    <string name="moose_answer_turn">পালার কোনো নির্দিষ্ট ধাপ নেই: নির্মাণ, সেনা নিয়োগ, অগ্রসর ও আক্রমণ, কার্ড খেলা ও কূটনীতি যেকোনো ক্রমে করুন। প্রস্তুত হলে “পালা শেষ করুন” চাপুন। তখন অন্য রাজ্যগুলো চাল দেয়, আপনি একটি কার্ড পান এবং আপনার আয় জমা হয়।</string>
    <string name="moose_answer_combat">আপনার একটি সেনাবাহিনীতে ট্যাপ করুন, তারপর একটি আলোকিত প্রদেশে: খালি প্রতিবেশী প্রদেশে যেতে, শত্রুর প্রদেশে আক্রমণ করতে। যুদ্ধশক্তি আসে অশ্বারোহী, পদাতিক, অবরোধ বাহিনী, ভূখণ্ড, দুর্গ ও বোনাস থেকে, সাথে পাশার দান; বেশি মোট যার, সে জেতে।</string>
    <string name="moose_answer_cards">আপনি ৫টি কার্ড নিয়ে শুরু করেন এবং প্রতি পালার শেষে আরেকটি পান। নিচে বাঁদিকে “কার্ড” খুলুন এবং আপনার পালায় যেকোনো সময় কার্ড খেলে তার বোনাস (সোনা, খাবার, আক্রমণ, প্রতিরক্ষা ইত্যাদি) নিন।</string>
    <string name="moose_answer_language">সেটিংসে ভাষা বদলান, যা প্রধান মেনু ও বিরতি মেনু দুটোতেই আছে। খেলাটি আপনার ফোনের ভাষা অনুসরণ করতে পারে বা এর ১৪টি ভাষার যেকোনোটি ব্যবহার করতে পারে।</string>
    <string name="moose_answer_save">প্রতি পালার পর এবং অ্যাপ ছাড়লেই খেলা নিজে থেকে সংরক্ষিত হয়; প্রধান মেনুর “চালিয়ে যান” যেখানে থেমেছিলেন সেখান থেকে শুরু করে। বিরতি মেনু থেকে পাঁচটি স্লটে সংরক্ষণ করতে এবং “খেলা লোড করুন” থেকে খুলতেও পারেন।</string>
